{
  "Minimal color logging": {
    "prefix": "logging",
    "description": "Minimal colored logging helpers: info, debug, warn, error (all to stderr)",
    "body": [
      "# --- logging ------------------------------------------------------------",
      "if [[ -t 2 ]]; then",
      "  LOG_RESET=\\$'\\033[0m'",
      "  LOG_BLUE=\\$'\\033[34m'",
      "  LOG_GRAY=\\$'\\033[90m'",
      "  LOG_YELLOW=\\$'\\033[33m'",
      "  LOG_RED=\\$'\\033[31m'",
      "else",
      "  LOG_RESET='' LOG_BLUE='' LOG_GRAY='' LOG_YELLOW='' LOG_RED=''",
      "fi",
      "",
      "_log() { printf '%s[%-5s]%s %s\\n' \"\\$2\" \"\\$1\" \"\\$LOG_RESET\" \"\\${*:3}\" >&2; }",
      "",
      "info()  { _log INFO  \"\\$LOG_BLUE\"   \"\\$@\"; }",
      "debug() { [[ -n \"\\${DEBUG:-}\" ]] || return 0; _log DEBUG \"\\$LOG_GRAY\" \"\\$@\"; }",
      "warn()  { _log WARN  \"\\$LOG_YELLOW\" \"\\$@\"; }",
      "error() { _log ERROR \"\\$LOG_RED\"    \"\\$@\"; }",
      "# -------------------------------------------------------------------------",
      "$0"
    ]
  }
}
